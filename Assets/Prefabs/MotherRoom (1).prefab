  m_GameObject: {fileID: 6898167905509240906}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2aaaa571f7ef5ff45a9b12d105ebbc3e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  interactText:
  - Despite being a double bed, I don't think Mother and Father sleep together anymore.
  - Back when I was home I don't think I ever saw Mother leave this bed.
  - I guess it makes me a little relieved to see her out of bed.
  - It's not like she never moved, I could always tell when she moved around.
  - I was just never allowed to see her out of bed.
  - Like I had no right to.
  collectable: 0
  interactable: {fileID: 0}
  itemDespawn: 0
  beingInteracted: 0
  canDespawn: 0
  interacted: 0
